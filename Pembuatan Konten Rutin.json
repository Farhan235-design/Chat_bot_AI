    {
      "parameters": {
        "jsCode": "// Konversi Base64 string -> Buffer biner, lalu jadikan binary item n8n\nconst base64 = $input.first().json.data;\nif (!base64) throw new Error('Data Base64 tidak ditemukan. Pastikan node Extract from File berjalan.');\n\nconst buffer = Buffer.from(base64, 'base64');\nconst binaryData = await this.helpers.prepareBinaryData(buffer, 'foto_telegram.jpg', 'image/jpeg');\n\nreturn [{\n  json: {\n    fileName: 'foto_telegram.jpg',\n    sizeKB: Math.round(buffer.length / 1024),\n    base64DataUrl: 'data:image/jpeg;base64,' + base64\n  },\n  binary: { data: binaryData }\n}];"
      },
      "id": "1c7f1a41-2853-4e46-bce5-2ee4221e0ccf",
      "name": "Code - Base64 ke Buffer",
