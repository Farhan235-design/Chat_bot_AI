    {
      "parameters": {
        "promptType": "define",
        "text": "=Kamu adalah content strategist profesional.\nSusun rencana konten harian untuk tanggal {{ $json.tanggal }} dengan tema: {{ $json.tema }}.\nBuat 5 slot waktu posting yang tersebar sepanjang hari (pagi sampai malam). Setiap slot berisi: time_slot (format HH:MM), title (judul ide konten yang spesifik dan menarik), platform (misal Instagram, TikTok, LinkedIn), dan focus (tujuan/fokus konten dalam 1 kalimat).\nGunakan Bahasa Indonesia. Keluarkan HANYA data sesuai skema JSON, tanpa teks pembuka atau penutup.",
        "hasOutputParser": true,
        "messages": {
          "messageValues": []
        }
      },
