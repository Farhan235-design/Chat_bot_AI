    {
      "parameters": {
        "jsCode": "// Ambil hasil analisis dari node sebelumnya\nconst items = $('Analisis Waktu Terbaik').all();\n\nif (!items || items.length === 0) {\n  return [{ json: { message: '❌ Tidak ada data untuk dikirim' } }];\n}\n\n// Ambil top 5 jam terbaik\nconst top5 = items.slice(0, 5);\nconst totalData = items[0].json.totalDataDianalisis || 'N/A';\nconst tanggalAnalisis = items[0].json.tanggalAnalisis || new Date().toLocaleString('id-ID');\nconst avgTop = (top5.reduce((s, i) => s + i.json.avgEngagement, 0) / top5.length).toFixed(2);\n\n// Logika medali untuk peringkat\nconst medali = ['🥇', '🥈', '🥉', '4️⃣', '5️⃣'];\n\n// Format pesan Telegram dengan emoji dan formatting\nlet message = `📊 *HASIL ANALISIS WAKTU POSTING TERBAIK*\\n`;\nmessage += `🗓 ${tanggalAnalisis}\\n`;\nmessage += `📁 Total data dianalisis: ${totalData} postingan\\n`;\nmessage += `📈 Avg Engagement (Top 5): ${avgTop}\\n\\n`;\nmessage += `🏆 *TOP 5 JAM TERBAIK:*\\n`;\nmessage += `━━━━━━━━━━━━━━━━━━━━\\n\\n`;\n\ntop5.forEach((item, index) => {\n  const d = item.json;\n  message += `${medali[index]} *Jam ${d.jam}*\\n`;\n  message += `     📈 Avg Engagement: ${d.avgEngagement}\\n`;\n  message += `     ${d.rekomendasi}\\n\\n`;\n});\n\nmessage += `━━━━━━━━━━━━━━━━━━━━\\n`;\nmessage += `_Gunakan insight ini untuk menjadwalkan posting berikutnya!_ 🚀`;\n\nreturn [{ json: { message } }];\n"
      },
