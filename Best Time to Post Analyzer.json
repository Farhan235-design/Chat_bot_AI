    {
      "parameters": {
        "jsCode": "// Ambil semua data dari Google Sheets\nconst items = $input.all();\n\nconsole.log('Total items:', items.length);\n\n// Validasi data\nif (!items || items.length === 0) {\n  throw new Error('Tidak ada data yang dibaca dari Google Sheets!');\n}\n\n// Ambil jam dari \"14:00\", \"14:30\", atau \"14\"\nfunction ambilJam(nilai) {\n  const s = String(nilai ?? '').trim();\n  const m = s.match(/(\\d{1,2}):\\d{2}/) || s.match(/^(\\d{1,2})$/);\n  if (!m) return null;\n  const jam = parseInt(m[1], 10);\n  return jam >= 0 && jam <= 23 ? jam : null;\n}\n\n// Kalkulasi: engagement score per postingan, diakumulasi per jam\nconst perJam = {};\nlet totalValid = 0;\n\nfor (const item of items) {\n  const row = item.json;\n  const jam = ambilJam(row['Jam Posting']);\n  if (jam === null) continue;\n\n  const likes = Number(row['Likes']) || 0;\n  const comments = Number(row['Comments']) || 0;\n  const shares = Number(row['Shares']) || 0;\n\n  // Bobot: Shares 3x, Comments 2x, Likes 1x\n  const engagement = likes + (comments * 2) + (shares * 3);\n\n  if (!perJam[jam]) {\n    perJam[jam] = { jam, totalEngagement: 0, likes: 0, comments: 0, shares: 0, jumlahPost: 0 };\n  }\n  perJam[jam].totalEngagement += engagement;\n  perJam[jam].likes += likes;\n  perJam[jam].comments += comments;\n  perJam[jam].shares += shares;\n  perJam[jam].jumlahPost += 1;\n  totalValid++;\n}\n\nif (totalValid === 0) {\n  throw new Error('Tidak ada baris valid. Cek kolom \"Jam Posting\".');\n}\n\nconst results = Object.values(perJam).map(j => ({\n  jam: String(j.jam).padStart(2, '0') + ':00',\n  avgEngagement: Number((j.totalEngagement / j.jumlahPost).toFixed(2)),\n  avgLikes: Number((j.likes / j.jumlahPost).toFixed(2)),\n  avgComments: Number((j.comments / j.jumlahPost).toFixed(2)),\n  avgShares: Number((j.shares / j.jumlahPost).toFixed(2)),\n  jumlahPost: j.jumlahPost,\n}));\n\n// Perankingan: sort berdasarkan engagement tertinggi\nresults.sort((a, b) => b.avgEngagement - a.avgEngagement);\n\nconst tanggalAnalisis = new Date().toLocaleString('id-ID', { timeZone: 'Asia/Jakarta' });\n\n// Ambil 10 jam teratas + label rekomendasi\nreturn results.slice(0, 10).map((r, index) => ({\n  json: {\n    peringkat: index + 1,\n    ...r,\n    rekomendasi: index < 3 ? '⭐ SANGAT DIREKOMENDASIKAN' : (index < 5 ? '✅ DIREKOMENDASIKAN' : '👍 CUKUP BAIK'),\n    totalDataDianalisis: totalValid,\n    tanggalAnalisis,\n  },\n}));\n"
      },
