    {
      "parameters": {
        "jsCode": "const now = DateTime.now().setZone('Asia/Jakarta');\nconst postsToSend = [];\n\n// Ubah \"11/02/2026\" (dd/MM/yyyy) atau \"2026-02-11\" menjadi \"2026-02-11\"\nfunction normalizeDate(str) {\n  const s = String(str).trim();\n  if (/^\\d{4}-\\d{2}-\\d{2}$/.test(s)) return s;\n  const m = s.match(/^(\\d{1,2})\\/(\\d{1,2})\\/(\\d{4})$/);\n  if (m) return `${m[3]}-${m[2].padStart(2, '0')}-${m[1].padStart(2, '0')}`;\n  return null;\n}\n\nfor (const item of $input.all()) {\n  const row = item.json;\n  const dateStr = row['Scheduled Date'];\n  const timeStr = row['Scheduled Time'];\n\n  if (String(row.Status).trim() === 'Pending' && dateStr && timeStr) {\n    const dateFixed = normalizeDate(dateStr);\n    if (!dateFixed) continue;\n\n    // \"9:30:00\" -> \"09:30:00\"\n    const [h, m = '00', s = '00'] = String(timeStr).trim().split(':');\n    const timeFixed = `${h.padStart(2, '0')}:${m.padStart(2, '0')}:${s.padStart(2, '0')}`;\n\n    const scheduledTime = DateTime.fromISO(`${dateFixed}T${timeFixed}`, { zone: 'Asia/Jakarta' });\n\n    if (scheduledTime.isValid && scheduledTime <= now) {\n      postsToSend.push(item);\n    }\n  }\n}\n\nreturn postsToSend;"
      },
