        -848,
        384
      ]
    },
    {
      "parameters": {
        "jsCode": "// Ambil respons dari node \"Mendapatkan Status\"\nconst res = $input.first().json;\nconst data = res.data || {};\n\n// resultJson biasanya berupa STRING JSON -> harus di-parse dulu\nlet result = data.resultJson;\nif (typeof result === 'string') {\n  try { result = JSON.parse(result); } catch (e) { result = {}; }\n}\nresult = result || {};\n\n// Ambil URL video (cadangan: beberapa format respons lain)\nconst videoUrl =\n  (result.resultUrls && result.resultUrls[0]) ||\n  (data.response && data.response.resultUrls && data.response.resultUrls[0]) ||\n  result.videoUrl ||\n  null;\n\nif (!videoUrl) {\n  throw new Error('videoUrl tidak ditemukan. Respons: ' + JSON.stringify(res));\n}\n\nreturn [{ json: { videoUrl, taskId: data.taskId } }];"
      },
