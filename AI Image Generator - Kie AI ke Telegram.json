    },
    {
      "parameters": {
        "jsCode": "// Parse resultJson (string) dan ambil maksimal 4 URL gambar dari resultUrls\nconst data = $input.first().json.data || {};\nlet result = {};\ntry {\n  result = JSON.parse(data.resultJson || '{}');\n} catch (e) {\n  throw new Error('resultJson tidak valid: ' + e.message);\n}\nconst urls = Array.isArray(result.resultUrls) ? result.resultUrls : [];\nreturn [{\n  json: {\n    img1: urls[0] || null,\n    img2: urls[1] || null,\n    img3: urls[2] || null,\n    img4: urls[3] || null\n  }\n}];"
      },
      "id": "7e51ad60-f5c5-4d41-af52-417ccd131c4b",
      "name": "Format Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -320,
        720
      ]
    },
    {
      "parameters": {
        "jsCode": "// Gabungkan img1..img4, buang nilai null, ubah menjadi item {url, index}\nconst d = $input.first().json;\nconst urls = [d.img1, d.img2, d.img3, d.img4].filter(u => u);\nif (urls.length === 0) {\n  throw new Error('Tidak ada URL gambar yang valid pada hasil generate');\n}\nreturn urls.map((url, i) => ({ json: { url, index: i + 1 } }));"
      },
      "id": "f93dcd8d-3023-4d05-a856-b3d7aa8efacb",
      "name": "Loop Image",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
